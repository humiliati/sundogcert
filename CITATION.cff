    family-names: Hughes
    name-suffix: Jr.
    orcid: "https://orcid.org/0009-0001-2875-5937"
    affiliation: "Independent Researcher; Stellar Aqua LLC"
version: "1.0.0"
date-released: "2026-06-15"
license: Apache-2.0
repository-code: "https://github.com/humiliati/sundogcert"
keywords:
  - Lean 4
  - mathlib
  - formal verification
  - interactive theorem proving
  - NP-hardness
  - Karp reduction
  - syndrome decoding
  - coding theory
  - 3-dimensional matching
  - exact cover
